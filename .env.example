# Swarmwright environment configuration
# Copy to .env and adjust.

# Database — SQLite by default. For PostgreSQL use:
#   postgresql://user:password@localhost:5432/swarmwright
# and switch the datasource provider in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# 32+ byte secret used to encrypt provider API keys at rest (AES-256-GCM).
# Generate one with: openssl rand -hex 32
SECRET_ENCRYPTION_KEY="change-me-generate-a-64-char-hex-string"

# Optional: default base URL overrides for OpenAI-compatible providers
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Sandbox limits (agent-generated tool code execution)
SANDBOX_TIMEOUT_MS="15000"
SANDBOX_MEMORY_MB="256"
SANDBOX_NETWORK="deny"
