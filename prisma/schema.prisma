// Swarmwright data model.
// SQLite by default for zero-config local dev. To use PostgreSQL, change the
// datasource provider to "postgresql" and set DATABASE_URL accordingly.
// NOTE: JSON payloads are stored as serialized strings (suffix `Json`) so the
// schema stays portable between SQLite and PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  passwordHash String
  createdAt    DateTime    @default(now())
  sessions     Session[]
  workspaces   Workspace[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id                  String               @id @default(cuid())
  name                String
  ownerId             String
  settingsJson        String               @default("{}")
  createdAt           DateTime             @default(now())
  owner               User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  providers           ProviderConnection[]
  projects            Project[]
  conversations       Conversation[]
  genomes             AgentGenome[]
  memories            MemoryItem[]
  usageRecords        UsageRecord[]

  @@index([ownerId])
}

model ProviderConnection {
  id              String    @id @default(cuid())
  workspaceId     String
  provider        String // openai | anthropic | openrouter | groq | deepseek | ollama | mock | openai-compatible
  label           String
  authType        String // api_key | none
  encryptedSecret String? // AES-256-GCM: iv.tag.ciphertext (base64) — never leaves the server
  baseUrl         String?
  status          String    @default("untested") // untested | ok | failed
  metadataJson    String    @default("{}")
  lastCheckedAt   DateTime?
  createdAt       DateTime  @default(now())
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model ModelCost {
  id           String @id @default(cuid())
  provider     String
  model        String
  inputPer1k   Float
  outputPer1k  Float
  contextLimit Int    @default(128000)

  @@unique([provider, model])
}

model Project {
  id           String         @id @default(cuid())
  workspaceId  String
  name         String
  description  String         @default("")
  settingsJson String         @default("{}")
  createdAt    DateTime       @default(now())
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  files        FileEntry[]
  runs         AgentRun[]
  plans        Plan[]
  tools        ToolDefinition[]
  artifacts    Artifact[]

  @@index([workspaceId])
}

model FileEntry {
  id        String        @id @default(cuid())
  projectId String
  path      String
  content   String
  language  String        @default("text")
  version   Int           @default(1)
  updatedAt DateTime      @updatedAt
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions  FileVersion[]

  @@unique([projectId, path])
  @@index([projectId])
}

model FileVersion {
  id        String    @id @default(cuid())
  fileId    String
  version   Int
  content   String
  createdAt DateTime  @default(now())
  file      FileEntry @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
}

model Conversation {
  id          String     @id @default(cuid())
  workspaceId String
  projectId   String?
  title       String
  mode        String     @default("chat") // chat | council
  archived    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@index([workspaceId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String // user | assistant | system | tool
  content        String
  provider       String?
  model          String?
  tokensIn       Int          @default(0)
  tokensOut      Int          @default(0)
  costUsd        Float        @default(0)
  parentId       String?
  metadataJson   String       @default("{}")
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Plan {
  id          String   @id @default(cuid())
  projectId   String?
  runId       String?
  goal        String
  summary     String   @default("")
  contentJson String   @default("{}") // full structured plan document
  status      String   @default("draft") // draft | awaiting_approval | approved | rejected | executing | completed
  mode        String   @default("plan_only") // plan_only | plan_approve | auto
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model AgentRun {
  id           String       @id @default(cuid())
  projectId    String
  goal         String
  status       String       @default("queued") // queued | planning | running | paused | awaiting_approval | completed | failed | stopped
  autonomy     String       @default("ask_risky") // observe | ask_all | ask_risky | auto
  branchOfId   String?
  budgetUsd    Float        @default(5)
  tokenLimit   Int          @default(500000)
  timeLimitSec Int          @default(1800)
  maxAgents    Int          @default(8)
  costUsd      Float        @default(0)
  tokensUsed   Int          @default(0)
  error        String?
  createdAt    DateTime     @default(now())
  startedAt    DateTime?
  endedAt      DateTime?
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agents       Agent[]
  tasks        Task[]
  approvals    Approval[]
  checkpoints  Checkpoint[]
  events       Event[]

  @@index([projectId])
  @@index([status])
}

model Agent {
  id           String    @id @default(cuid())
  runId        String
  name         String
  role         String
  provider     String
  model        String
  status       String    @default("idle") // idle | active | waiting | paused | failed | completed | removed
  genomeId     String?
  summary      String    @default("")
  confidence   Float     @default(0.5)
  recruited    Boolean   @default(false)
  tokensIn     Int       @default(0)
  tokensOut    Int       @default(0)
  costUsd      Float     @default(0)
  createdAt    DateTime  @default(now())
  endedAt      DateTime?
  run          AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model AgentGenome {
  id                   String    @id @default(cuid())
  workspaceId          String
  name                 String
  roleDescription      String    @default("")
  provider             String
  model                String
  systemPrompt         String    @default("")
  temperature          Float     @default(0.3)
  planningDepth        Int       @default(2)
  toolProfileJson      String    @default("[]")
  verificationStrategy String    @default("self_review")
  collaborationStyle   String    @default("structured")
  successRate          Float     @default(0.5)
  avgLatencyMs         Float     @default(0)
  avgCostUsd           Float     @default(0)
  runs                 Int       @default(0)
  failurePatternsJson  String    @default("[]")
  bestCategoriesJson   String    @default("[]")
  locked               Boolean   @default(false)
  learningEnabled      Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Task {
  id          String    @id @default(cuid())
  runId       String
  title       String
  description String    @default("")
  status      String    @default("pending") // pending | blocked | active | completed | failed | cancelled
  dependsJson String    @default("[]") // string[] of task ids
  agentId     String?
  priority    Int       @default(0)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  result      String?
  error       String?
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  endedAt     DateTime?
  run         AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([status])
}

model ToolDefinition {
  id               String          @id @default(cuid())
  projectId        String
  name             String
  description      String          @default("")
  version          Int             @default(1)
  type             String          @default("js_function") // js_function | http | shell | file_transform | search | code_analysis | automation
  inputSchemaJson  String          @default("{}")
  outputSchemaJson String          @default("{}")
  permissionsJson  String          @default("[]")
  sourceCode       String
  testCode         String          @default("")
  riskLevel        String          @default("low") // low | medium | high
  timeoutMs        Int             @default(10000)
  authorAgentId    String?
  status           String          @default("draft") // draft | pending_approval | approved | rejected | archived
  auditJson        String          @default("[]")
  createdAt        DateTime        @default(now())
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executions       ToolExecution[]

  @@index([projectId])
}

model ToolExecution {
  id         String          @id @default(cuid())
  toolId     String?
  runId      String?
  agentId    String?
  taskId     String?
  inputJson  String          @default("{}")
  outputJson String          @default("{}")
  status     String          @default("running") // running | completed | failed | denied
  durationMs Int             @default(0)
  createdAt  DateTime        @default(now())
  tool       ToolDefinition? @relation(fields: [toolId], references: [id], onDelete: SetNull)

  @@index([runId])
}

model Approval {
  id         String    @id @default(cuid())
  runId      String
  agentId    String?
  kind       String // tool_execute | tool_register | high_risk | budget | recruitment
  title      String
  detailJson String    @default("{}")
  riskLevel  String    @default("medium")
  status     String    @default("pending") // pending | approved | rejected | expired
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())
  run        AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, status])
}

model Event {
  id          Int       @id @default(autoincrement())
  runId       String?
  projectId   String?
  type        String // RUN_CREATED, AGENT_STARTED, ... (see SPEC events section)
  actorType   String    @default("system") // system | agent | user | coordinator
  actorId     String?
  summary     String    @default("")
  payloadJson String    @default("{}")
  createdAt   DateTime  @default(now())
  run         AgentRun? @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, id])
  @@index([type])
}

model Checkpoint {
  id        String   @id @default(cuid())
  runId     String
  label     String
  stateJson String   @default("{}") // full resumable run state snapshot
  eventSeq  Int      @default(0)
  createdAt DateTime @default(now())
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model MemoryItem {
  id          String     @id @default(cuid())
  workspaceId String
  projectId   String?
  runId       String?
  agentId     String?
  scope       String // conversation | agent | run | project | longterm | tool_perf
  key         String
  content     String
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, scope])
  @@index([runId])
}

model UsageRecord {
  id          String    @id @default(cuid())
  workspaceId String
  projectId   String?
  runId       String?
  agentId     String?
  provider    String
  model       String
  tokensIn    Int       @default(0)
  tokensOut   Int       @default(0)
  costUsd     Float     @default(0)
  kind        String    @default("chat") // chat | agent | tool | planning
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([runId])
}

model Artifact {
  id           String   @id @default(cuid())
  projectId    String
  runId        String?
  name         String
  kind         String   @default("document") // document | code_bundle | report
  path         String   @default("")
  content      String   @default("")
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  actor       String
  action      String
  detailJson  String   @default("{}")
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
}
